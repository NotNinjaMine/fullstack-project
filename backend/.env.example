# =====================================================================
# Innovare Leave Management System — server configuration
#
# SETUP:  copy this file to `.env` in this same folder, then fill in the
#         REQUIRED section. Everything below that is optional.
#
#   cp .env.example .env
#
# The app only reads a file named exactly `.env`. Nothing else is loaded.
# NEVER commit `.env` — it is gitignored for a reason.
#
# ---------------------------------------------------------------------
# ONE FILE COVERS BOTH DEMO AND LIVE. There is no "demo mode" switch to
# flip. The app decides per-recipient:
#
#   • Seeded demo accounts (@innovare.com, +65912300xx) are placeholders,
#     so no real email/SMS is attempted — their codes appear ON SCREEN.
#     Every demo role and page keeps working with zero setup.
#
#   • Any REAL address or number — an account you create in the app via
#     HR "Add employee" or an invitation — gets a GENUINE email / text.
#
# So filling in the SMTP/Twilio sections below ADDS live capability on
# top of the demo; it never takes the demo away.
# =====================================================================


# =====================================================================
# REQUIRED — the app will not start correctly without these
# =====================================================================

# ─── App ─────────────────────────────────────────────────────────────
APP_PORT=3001
# Signs the login tokens. Any long random string; change it for real use.
APP_SECRET=change-this-to-a-long-random-string
TOKEN_EXPIRES_IN=30d

# Where the FRONTEND runs. Used to build the links inside emails, so if
# this is wrong the invitation/reset links in the inbox will be broken.
CLIENT_URL=http://localhost:3000

# ─── Database (MySQL) ────────────────────────────────────────────────
# Create the database first:  CREATE DATABASE leave;
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PWD=your_mysql_password
DB_NAME=leave


# =====================================================================
# OPTIONAL — leave blank and the app still works
# =====================================================================

# ─── Email: real invitations, password resets, 2FA codes ─────────────
# Blank  -> demo mode: links/codes are logged to the console AND returned
#           in the API response, so every flow is still demonstrable.
# Filled -> real email to real addresses (demo accounts still on-screen).
#
# Get an App Password from your GOOGLE ACCOUNT (not the Twilio console):
#   Google Account -> Security -> 2-Step Verification -> App passwords
#
# Use a PERSONAL Gmail. A school/NYP Microsoft account will not work —
# Microsoft disabled basic SMTP auth, so it fails to authenticate.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Example once filled in:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.name@gmail.com
#   SMTP_PASS=abcdefghijklmnop        <- 16 chars, no spaces
#   SMTP_FROM=your.name@gmail.com

# ─── SMS: phone 2-step verification codes ────────────────────────────
# Only needed if users pick "text me a code" at sign-in. Email 2FA needs
# nothing here. Blank -> phone codes are shown on screen instead.
#
# From the TWILIO CONSOLE:
#   Account SID + Auth Token   -> dashboard home page
#   TWILIO_FROM                -> Phone Numbers -> claim your trial number
#
# TRIAL ACCOUNTS can only text numbers you have verified under
# Console -> Verified Caller IDs (error 21608 otherwise). Upgrading
# removes that restriction. Numbers must include the country code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Alternative to a single number — a Messaging Service:
TWILIO_MESSAGING_SERVICE_SID=
# Example once filled in:
#   TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_AUTH_TOKEN=your_auth_token
#   TWILIO_FROM=+15551234567

# ─── AI / LLM ────────────────────────────────────────────────────────
# Powers AI-1 (plain-English apply), AI-3 (approval summary) and AI-4
# (HR chatbot). Blank -> a built-in offline heuristic is used and every
# AI feature still works, just without an LLM.
#
# Use EITHER OPENAI_API_KEY or OPENROUTER_API_KEY (same value, sk-or-v1-...)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
# Optional OpenRouter ranking headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Innovare Leave Management
# Anthropic fallback (used only if the keys above are empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=


# =====================================================================
# KEEP AS-IS — this is what lets demo and live accounts coexist
# =====================================================================
# Recipients matching these are treated as placeholders: no real delivery
# is attempted and the code/link is shown in the app instead.
#
# Without them, the seeded accounts would try to send to @innovare.com
# (not a real domain) and +65912300xx (nobody's phone). The send would
# appear to succeed, the on-screen fallback would be suppressed, and you
# would be locked out of your own demo accounts mid-presentation.
#
# Comma-separate to add more.
DEMO_EMAIL_DOMAINS=innovare.com
DEMO_PHONE_PREFIXES=+65912300


# =====================================================================
# OPTIONAL — funnel ALL mail/SMS to one inbox or phone
# =====================================================================
# Normally leave BLANK. The two settings above already give you a live
# account plus working demo accounts side by side.
#
# Set these only if you want even the DEMO accounts' messages delivered
# somewhere real (the intended recipient is kept in the subject line):
#   DEMO_EMAIL_REDIRECT=you@example.com
#   DEMO_SMS_REDIRECT=+6591234567
#
# While either is set, 2FA codes are ALSO shown on screen as a fallback,
# so a slow inbox can never strand you mid-demo.
# MUST be blank for any real deployment — it intercepts everything.
DEMO_EMAIL_REDIRECT=
DEMO_SMS_REDIRECT=
