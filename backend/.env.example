# --- Server ---
APP_PORT=3001
CLIENT_URL=http://localhost:3000
APP_SECRET=replace_me_with_a_long_random_string
TOKEN_EXPIRES_IN=8h

# --- Database ---
# Dialect defaults to sqlite (zero-infra, runs anywhere). Switch to the team's
# MySQL by setting DB_DIALECT=mysql and filling in the connection details below
# — the Sequelize models are dialect-agnostic, so nothing else changes.
DB_DIALECT=sqlite
DB_STORAGE=./data/lms.sqlite

# Used only when DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PWD=
DB_NAME=leave

# --- Email ---
# Required for password-reset and employee-invitation links to be EMAILED.
# Leave blank for demo mode: links are logged to the server console and returned
# in the API response instead, so the flow still works offline.
#
# Verify whatever you put here with:  npm run mail:test your.address@example.com
#
# Gmail (needs 2-Step Verification, then an App Password — your normal Google
# password will NOT work: https://myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password, no spaces>
#
# Outlook / Microsoft 365
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#
# Brevo (free tier, good for a school project — the SMTP key is not your password)
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your brevo login>
#   SMTP_PASS=<your brevo SMTP key>
#
# Mailtrap (sandbox: catches mail in a fake inbox instead of delivering it —
# useful for testing without emailing real people)
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name. Many providers require this to match SMTP_USER or a
# domain you've verified, otherwise the message is rejected or spam-filed.
SMTP_FROM=
