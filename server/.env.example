# Copy to server/.env and fill in the blank values for your machine.
# Blank entries are secrets: never commit or share them once filled in.

APP_PORT=3001
CLIENT_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────
# Use the LIMITED application user, never MySQL root.
#   CREATE DATABASE `leave`;
#   CREATE USER 'leave'@'localhost' IDENTIFIED BY '<your-local-password>';
#   GRANT ALL PRIVILEGES ON `leave`.* TO 'leave'@'localhost';
DB_HOST=localhost
DB_PORT=3306
DB_USER=leave
DB_PWD=
DB_NAME=leave

# Required. The server refuses to start without it (no insecure default).
APP_SECRET=
TOKEN_EXPIRES_IN=30d

# Business timezone for delegation windows, reminder ages and audit display.
APP_TIMEZONE=Asia/Singapore

# ─── Two-step verification (2FA) ─────────────────────────────────
# always   = every sign-in is challenged (default, and what production uses)
# optional = only accounts that opted in under "My account -> 2-step"
#
# There is NO 2FA bypass anywhere, including tests. The M3 integration suite
# completes the real challenge: with no SMTP/SMS transport configured,
# POST /user/2fa/send returns `demoCode` so the flow works offline. That demo
# affordance is disabled whenever NODE_ENV=production.
TWO_FACTOR_MODE=always

# ─── Test database ───────────────────────────────────────────────
# `npm test` loads server/.env.test (gitignored) INSTEAD of these values and
# must point at a DEDICATED schema so the demo data is never clobbered:
#   DB_NAME=leave_test        NODE_ENV=test
# Create it with:  npm run seed:test

# ─── AI / LLM (optional) ─────────────────────────────────────────
# Prefer OpenRouter (OpenAI-compatible). Leave keys blank to use the
# offline heuristic parser — the app still works without AI.
#
# NEVER commit real keys. Put them only in server/.env (gitignored).

# OpenRouter / OpenAI-compatible
# Use either OPENAI_API_KEY or OPENROUTER_API_KEY (same value: sk-or-v1-...)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5.6-sol
# Optional OpenRouter ranking headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Innovare Leave Management

# Legacy Anthropic (used only if OPENAI_API_KEY is empty)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Cost control is applied in code (low max_tokens + low temperature).
# Every hosted-LLM call is bounded by this timeout (milliseconds). On timeout,
# a missing key, a rate limit, a provider error or a malformed response, the
# feature falls back to its deterministic non-AI output — the approval page
# stays fully usable. Automated tests always run with the key blank and the
# LLM client mocked, so they never spend credits.
LLM_TIMEOUT_MS=8000

# ─── Email (SMTP) — optional ─────────────────────────────────────
# Used for ALL outgoing mail:
#   • forgot-password links   (?resetToken=…)
#   • employee invitation / onboarding links (?inviteToken=…)
#   • approval / comment / reminder notifications and scheduled reports
#
# Keep SMTP_ENABLED=false for offline/demo mode. Authentication demo tokens may
# be returned only by their existing protected/demo flows; tokens and SMTP
# credentials are never printed by the mail service.
# Set SMTP_ENABLED=true only after filling every placeholder in server/.env.
#
# Gmail requires an App Password, not the normal account password. Enter it
# manually in server/.env and never commit that file.
#
# CLIENT_URL (above) is used to build the links in these emails, so it must
# point at where the frontend actually runs or the links will be broken.
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Annual Leave Management System
SMTP_FROM_EMAIL=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Optional DEVELOPMENT-ONLY delivery redirect. Keep false normally. When some
# demo @wypledu.online aliases are not provisioned, this can route all outgoing
# test messages to one controlled inbox while retaining the intended address in
# message metadata. Production ignores this mode even when enabled accidentally.
EMAIL_TEST_MODE=false
EMAIL_TEST_REDIRECT_TO=

# Legacy local files using SMTP_FROM remain supported as an alias for
# SMTP_FROM_EMAIL, but new configuration should use SMTP_FROM_EMAIL.

# ─── SMS (Twilio) — optional, for 2FA codes by text message ───────
# Only needed if users choose "text message" for 2-step verification. Email 2FA
# needs no extra setup beyond SMTP above. Leave blank and phone codes are shown
# in-app for the demo instead of being texted.
#
# Get these from the Twilio Console (a free trial account works):
#   TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_AUTH_TOKEN=your_auth_token
#   TWILIO_FROM=+15551234567          <- your Twilio phone number, E.164 format
# Or use a Messaging Service instead of a single number:
#   TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# NOTE: a Twilio TRIAL account can only text numbers you have verified in
# Console -> Phone Numbers -> Verified Caller IDs. Sending to any other number
# fails with error 21608. Verify your own mobile first, or upgrade the account.
# Phone numbers on user profiles must include the country code (e.g. +6591234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ==============================================================