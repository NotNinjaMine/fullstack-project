# Root template only. Runtime configuration belongs in server/.env and client/.env.
# Never put real passwords, API keys, or database credentials in this file.

NODE_ENV=development
APP_PORT=3001
CLIENT_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PWD=your_mysql_password
DB_NAME=leave
APP_SECRET=replace-with-a-long-random-secret
VITE_API_BASE_URL=http://localhost:3001
